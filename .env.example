# Database — for local dev SQLite is fine. Swap to postgres in prod.
DATABASE_URL="file:./dev.db"

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-64-char-hex-string-or-the-app-will-refuse-to-boot-xxxxx"

# Rates provider: "mock" today. Direct carrier providers (xpo, estes, odfl, saia,
# arcbest, fedex_freight, project44) plug into src/lib/rates/providers/ later.
RATES_PROVIDER="mock"

# Markup applied on top of carrier rates (decimal). 0.10 = 10%
RATES_MARKUP="0.10"
