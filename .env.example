# --- Database -----------------------------------------------------------
# SQLite for dev; swap to postgres for prod (change schema.prisma + url).
DATABASE_URL="file:./dev.db"

# --- Session ------------------------------------------------------------
# Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-64-char-hex-string-or-the-app-will-refuse-to-boot-xxxxx"

# --- Rates engine -------------------------------------------------------
# "mock" — built-in simulator (always works, used by default)
# "live" — every direct-carrier provider that has creds below.
#          Unconfigured providers are skipped; if none are set, falls back
#          to mock so the app keeps working.
RATES_PROVIDER="mock"

# Fathership service fee on top of carrier subtotal. 0.10 = 10%.
RATES_MARKUP="0.10"

# --- Carrier APIs (all free with a carrier account; see docs/CARRIERS.md)

# FedEx Freight  https://developer.fedex.com
#   - Easiest carrier to start with: anyone can sign up.
#   - Production base: https://apis.fedex.com  (sandbox: https://apis-sandbox.fedex.com)
FEDEX_API_BASE="https://apis-sandbox.fedex.com"
FEDEX_CLIENT_ID=""
FEDEX_CLIENT_SECRET=""
FEDEX_ACCOUNT_NUMBER=""

# Estes Express  https://www.estes-express.com/myestes/api
#   - Free with an Estes shipper account; rep emails API key.
ESTES_API_BASE="https://api.estes-express.com"
ESTES_API_KEY=""
ESTES_ACCOUNT_NUMBER=""

# Old Dominion (ODFL)  https://www.odfl.com/ — ask your rep for Web Services access
#   - Uses HTTP Basic auth with the username/password they issue.
ODFL_API_BASE="https://api.odfl.com"
ODFL_USERNAME=""
ODFL_PASSWORD=""
ODFL_ACCOUNT_NUMBER=""
